+  void _scheduleReconnect() {
+    if (!_active || reconnectTimer != null || _connecting) return;
+    if (reconnectTime >= maxReconnectTime) {
+      onClose?.call('重连超过最大次数，与服务器断开连接');
       close();
       return;
     }
+
+    reconnectTime++;
+    reconnectTimer = Timer(reconnectDelay, () {
+      reconnectTimer = null;
+      if (!_active) return;
+      onReconnect?.call();
